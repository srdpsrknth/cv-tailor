\newcommand{\metadata}{\fontsize{9.5}{11}\selectfont}
\setlist[itemize]{leftmargin=1.2em,label=\textbullet,itemsep=1pt,topsep=2pt,parsep=0pt,partopsep=0pt}
{% raw %}
\newcommand{\cvsection}[1]{\needspace{3\baselineskip}\par\vspace{7pt}{\large\bfseries\color{accent}\MakeUppercase{#1}\par}\vspace{1pt}{\color{accent}\hrule height 0.6pt}\vspace{4pt}}
\newcommand{\projectheading}[1]{\needspace{3\baselineskip}\vspace{2pt}{\bfseries #1\par}\nopagebreak}
{% endraw %}
\begin{document}
\normalsize\color{bodytext}
{\fontsize{22}{25}\selectfont\bfseries\color{accent}\MakeUppercase{{ "{" }}{{ name }}{{ "}" }}\par}
\vspace{3pt}
{\bfseries {{ tagline }}\par}
\vspace{3pt}
{\metadata
{{ location }}{% if phone %} | {{ phone }}{% endif %}{% if email %} | {{ email }}{% endif %}\par
{% if linkedin %}\href{{ '{' }}{{ linkedin }}{{ '}' }}{{ '{' }}{{ linkedin|replace('https://www.', '')|replace('https://', '') }}{{ '}' }}{% endif %}{% if github %}{% if linkedin %} | {% endif %}\href{{ '{' }}{{ github }}{{ '}' }}{{ '{' }}{{ github|replace('https://www.', '')|replace('https://', '') }}{{ '}' }}{% endif %}\par
{% if work_authorization %}Work authorization: {{ work_authorization }}\par{% endif %}
}
{% if summary %}
\vspace{6pt}
{{ summary|join(' ') }}\par
{% endif %}
\cvsection{Professional Experience}
{% for exp in experience %}
\needspace{4\baselineskip}
\begin{samepage}
{\bfseries {{ exp.role }} | {{ exp.company }}\par}\nopagebreak
{\metadata\color{muted}{{ exp.start_date }} -- {{ exp.end_date }}{% if exp.location %} | {{ exp.location }}{% endif %}\par}\nopagebreak
{% if exp.bullets %}
\begin{itemize}
{% for bullet in exp.bullets %}\item {{ bullet }}
{% endfor %}
\end{itemize}
{% endif %}
\end{samepage}
{% if exp.projects %}
{% for project in exp.projects %}
\begin{samepage}
\projectheading{Selected Projects: {{ project.name }} ({{ exp.company }})}
\begin{itemize}
{% for bullet in project.bullets %}\item {{ bullet }}
{% endfor %}
\end{itemize}
\end{samepage}
{% endfor %}
{% endif %}
{% if exp.technologies %}
{\metadata\textbf{Technologies: }{{ exp.technologies|join(', ') }}\par}
{% endif %}
{% if not loop.last %}\vspace{6pt}{% endif %}
{% endfor %}
{% if education %}
\cvsection{Education}
{% for edu in education %}
\needspace{3\baselineskip}
{\bfseries {{ edu.degree }}\par}\nopagebreak
{\metadata {{ edu.institution }} | {{ edu.start_year }} -- {{ edu.end_year }}{% if edu.location %} | {{ edu.location }}{% endif %}\par}
{% if not loop.last %}\vspace{4pt}{% endif %}
{% endfor %}
{% endif %}
{% if certifications %}
\cvsection{Certifications}
{\metadata {{ certifications|join('; ') }}\par}
{% endif %}
{% if skills %}
\cvsection{Skills}
{% for category, skill_list in skills.items() %}
\needspace{2\baselineskip}
\textbf{{ '{' }}{{ category }}:{{ '}' }} {{ skill_list|join(', ') }}\par
{% if not loop.last %}\vspace{2pt}{% endif %}
{% endfor %}
{% endif %}
{% if languages %}
\cvsection{Languages}
{% for lang in languages %}{{ lang.name }}: {{ lang.proficiency }}{% if not loop.last %} | {% endif %}{% endfor %}\par
{% endif %}
