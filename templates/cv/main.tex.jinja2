\newcommand{\metadata}{\fontsize{9.5}{11}\selectfont}
\newcommand{\sectiongap}{{ '{' }}{{ layout.section_spacing }}pt{{ '}' }}
\setlist[itemize]{leftmargin=1.2em,label=\textbullet,itemsep={{ layout.item_spacing }}pt,topsep=3pt,parsep=0pt,partopsep=0pt}
{% raw %}
\newcommand{\cvsection}[1]{\needspace{4\baselineskip}\par\vspace{\sectiongap}{\fontsize{12.5}{15}\selectfont\bfseries\color{accent}\MakeUppercase{#1}\par}\vspace{3pt}{\color{accent}\hrule height 0.6pt}\vspace{6pt}}
\newcommand{\projectheading}[4]{\needspace{3\baselineskip}\vspace{3pt}{\metadata\bfseries\color{accent}Selected Projects:}\enspace {\itshape #1}\label{project-#3-#4}\enspace {\metadata\color{muted}(#2\ifnum\getpagerefnumber{project-#3-#4}>\getpagerefnumber{employer-#3}\relax{} - continued\fi)}\par\nopagebreak}
{% endraw %}
\begin{document}
\normalsize\color{bodytext}
% The compact top block stays in the document body, never a page header/footer.
% Offset the initial minipage baseline to retain the previous top text position.
\vspace*{-22pt}
\noindent\begin{minipage}[t]{0.485\linewidth}
\vspace{0pt}
{\fontsize{26}{29}\selectfont\bfseries\color{bodytext}\MakeUppercase{{ "{" }}{{ name }}{{ "}" }}\par}
\end{minipage}\hfill
\begin{minipage}[t]{0.495\linewidth}
\vspace{0pt}
\raggedleft\metadata\color{muted}
{{ location }}{% if phone %} | {{ phone }}{% endif %}{% if email %} | \href{{ '{' }}mailto:{{ email }}{{ '}' }}{{ '{' }}{{ email }}{{ '}' }}{% endif %}\par

{% if linkedin %}\href{{ '{' }}{{ linkedin }}{{ '}' }}{{ '{' }}{{ linkedin|replace('https://www.', '')|replace('https://', '') }}{{ '}' }}\par{}{% endif %}
{% if github %}\href{{ '{' }}{{ github }}{{ '}' }}{{ '{' }}{{ github|replace('https://www.', '')|replace('https://', '') }}{{ '}' }}\par{}{% endif %}
{% if work_authorization %}Work authorization: {{ work_authorization }}\par{}{% endif %}
\end{minipage}\par
\vspace{4pt}{\fontsize{11}{13}\selectfont\bfseries\color{accent}{{ tagline }}\par}
{% if summary %}
\vspace{8pt}
{{ summary|join(' ') }}\par
{% endif %}
{% for section in cv_section_order %}
{% if section == 'experience' and experience %}
\cvsection{Professional Experience}
{% for exp in experience %}
{% set employer_index = loop.index0 %}
{% set split_role = split_before and split_before[0] == employer_index %}
{% if split_role %}
{% set split_kind = split_before[1] %}
{% set split_index = split_before[2] %}
{% endif %}
{% if break_before_employer_index == employer_index %}\newpage{% endif %}
\needspace{4\baselineskip}
\begin{samepage}
{\fontsize{11.5}{13.5}\selectfont\bfseries {{ exp.company }}\label{employer-{{ employer_index }}}\par}\nopagebreak
\vspace{2pt}{\bfseries\color{accent}{{ exp.role }}}\hfill {\metadata\color{muted}{{ exp.start_date }} -- {{ exp.end_date }}{% if exp.location %} | {{ exp.location }}{% endif %}}\par\nopagebreak
{% if exp.bullets %}
\begin{itemize}
{% for bullet in exp.bullets %}
{% if split_role and split_kind == 'bullet' and split_index == loop.index0 %}
\end{itemize}
\end{samepage}
\newpage
\begin{samepage}
{\metadata\bfseries\color{accent}{{ exp.company }} | {{ exp.role }} (continued)\par}\nopagebreak
\begin{itemize}
{% endif %}
\item {{ bullet }}
{% endfor %}
\end{itemize}
{% endif %}
{% if split_role and not exp.projects and exp.technologies %}
\nopagebreak
\vspace{2pt}{\metadata\textbf{\textcolor{muted}{Technologies: }}{{ exp.technologies|join(', ') }}\par}
{% endif %}
\end{samepage}
{% if exp.projects %}
{% for project in exp.projects %}
{% set split_here = split_role and split_kind == 'project' and split_index == loop.index0 %}
{% if split_here %}\newpage{% endif %}
\begin{samepage}
{% if split_here %}
{\metadata\bfseries\color{accent}{{ exp.company }} | {{ exp.role }} (continued)\par}\nopagebreak
{% endif %}
\projectheading{{ "{" }}{{ project.name }}{{ "}" }}{{ "{" }}{{ exp.company }}{{ "}" }}{{ '{' }}{{ employer_index }}{{ '}{' }}{{ loop.index0 }}{{ '}' }}
\begin{itemize}
{% for bullet in project.bullets %}\item {{ bullet }}
{% endfor %}
\end{itemize}
{% if split_role and loop.last and exp.technologies %}
\nopagebreak
\vspace{2pt}{\metadata\textbf{\textcolor{muted}{Technologies: }}{{ exp.technologies|join(', ') }}\par}
{% endif %}
\end{samepage}
{% endfor %}
{% endif %}
{% if exp.technologies and not split_role %}
\vspace{2pt}{\metadata\textbf{\textcolor{muted}{Technologies: }}{{ exp.technologies|join(', ') }}\par}
{% endif %}
{% if not loop.last %}\vspace{3pt}{\color{divider}\hrule height 0.35pt}\vspace{5pt}{% endif %}
{% endfor %}
{% elif section == 'projects' and standalone_projects %}
\cvsection{Projects}
{% for project in standalone_projects %}
\needspace{3\baselineskip}
{\bfseries {{ project.name }}\par}
{% if project.bullets %}
\nopagebreak
\begin{itemize}
{% for bullet in project.bullets %}\item {{ bullet }}
{% endfor %}
\end{itemize}
{% endif %}
{% endfor %}
{% elif section == 'education' and education %}
\cvsection{Education}
{% for edu in education %}
\needspace{3\baselineskip}
{\bfseries {{ edu.degree }}\par}\nopagebreak
{\metadata {{ edu.institution }} | {{ edu.dates }}{% if edu.location %} | {{ edu.location }}{% endif %}\par}
{% if not loop.last %}\vspace{4pt}{% endif %}
{% endfor %}
{% elif section == 'certifications' and certifications %}
\cvsection{Certifications}
{\metadata {{ certifications|join('; ') }}\par}
{% elif section == 'skills' and skills %}
\cvsection{Skills}
{% for category, skill_list in skills.items() %}
\needspace{2\baselineskip}
\textbf{{ '{' }}{{ category }}:{{ '}' }} {{ skill_list|join(', ') }}\par
{% if not loop.last %}\vspace{2pt}{% endif %}
{% endfor %}
{% elif section == 'languages' and languages %}
\cvsection{Languages}
{% for lang in languages %}{{ lang.name }}: {{ lang.proficiency }}{% if not loop.last %} | {% endif %}{% endfor %}\par
{% elif section == 'publications' and publications %}
\cvsection{Publications}
{% for entry in publications %}{\metadata {{ entry }}\par}
{% endfor %}
{% elif section == 'activities' and activities %}
\cvsection{Activities}
{% for entry in activities %}{\metadata {{ entry }}\par}
{% endfor %}
{% endif %}
{% endfor %}
\end{document}
