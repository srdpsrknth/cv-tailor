\definecolor{accent}{HTML}{00004D}
\definecolor{bodytext}{HTML}{222222}
\definecolor{muted}{HTML}{4A5568}
\hypersetup{hidelinks,pdfauthor={{ '{' }}{{ name }}{{ '}' }},pdftitle={{ '{' }}{{ name }} - CV{{ '}' }}}
\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\raggedright
\hyphenpenalty=10000
\emergencystretch=2em
