\documentclass[10pt,a4paper,ragged2e]{altacv}

% Page layout - ATS-friendly margins
% Optimized for 2-page maximum with good spacing
\geometry{left=1.5cm,right=1.5cm,marginparwidth=6.8cm,marginparsep=1.2cm,top=1.25cm,bottom=1.25cm}

% Section integrity - prevent splitting across pages
\usepackage{needspace}

% Font configuration for ATS compatibility
\ifxetexorluatex
  \setmainfont{Carlito}
\else
  \usepackage[utf8]{inputenc}
  \usepackage[T1]{fontenc}
  \usepackage[default]{lato}
\fi

\usepackage{multicol}
\usepackage{hyperref}

% Spacing optimization for 2-page limit
\setlength{\parskip}{0.3ex}
\setlength{\parsep}{0pt}

% Color scheme
\definecolor{NavyBlue}{HTML}{00004d}
\definecolor{SlateGrey}{HTML}{2E2E2E}
\definecolor{LightGrey}{HTML}{666666}
\colorlet{heading}{NavyBlue}
\colorlet{accent}{NavyBlue}
\colorlet{emphasis}{SlateGrey}
\colorlet{body}{LightGrey}

% Typography settings for better ATS parsing
\tolerance=1
\emergencystretch=\maxdimen
\hyphenpenalty=10000
\hbadness=10000

\usepackage{paracol}

% Bullet markers
\renewcommand{\itemmarker}{{ '{' }}{\small\textbullet}{{ '}' }}
\renewcommand{\ratingmarker}{\faCircle}

\begin{document}

% Header with personal information
\name{{ '{' }}{{ name }}{{ '}' }}
\tagline{{ '{' }}{{ tagline }}{{ '}' }}

\personalinfo{{ '{' }}%
  \email{\href{mailto:{{ email }}}{{ '{' }}{{ email }}{{ '}' }}}
  \phone{\href{tel:{{ phone|replace(' ', '') }}}{{ '{' }}{{ phone }}{{ '}' }}}
  {% if linkedin -%}
  \linkedin{\href{{ '{' }}{{ linkedin }}{{ '}' }}{{ '{' }}{{ linkedin|replace('https://www.linkedin.com/in/', '') }}{{ '}' }}}
  {%- endif %}
  {% if github -%}
  \github{\href{{ '{' }}{{ github }}{{ '}' }}{{ '{' }}{{ github|replace('https://github.com/', '') }}{{ '}' }}}
  {%- endif %}
{{ '}' }}

\makecvheader

% Professional Summary
{% if summary %}
\vspace{2mm}
\small {{ summary|join(' ') }}
\vspace{2mm}
{% endif %}

\AtBeginEnvironment{itemize}{\small}

% PROFESSIONAL EXPERIENCE
\cvsection{Professional Experience}

{% for exp in experience %}
% Prevent page break within a role
\needspace{3.5cm}
\begin{samepage}
\cveventsmall{{ '{' }}{{ exp.company }}{{ '}' }}{{ '{' }}{{ exp.role }}{{ '}' }}{{ '{' }} 
  {%- if exp.start_date -%}
    {{ exp.start_date|replace('-', ' - ') }}
  {%- endif -%}
  {%- if exp.end_date -%}
    {%- if exp.end_date == 'present' %} -- present{% else %} -- {{ exp.end_date|replace('-', ' - ') }}{% endif -%}
  {%- endif -%}
{{ '}' }}{{ '{' }}{{ exp.location }}{{ '}' }}

{% if exp.bullets %}
\begin{itemize}
{% for bullet in exp.bullets %}
\item {{ bullet }}
{% endfor %}
\end{itemize}
{% endif %}

{% if exp.projects %}
% Selected Projects - new structure (each project has own bullets)
\vspace{1mm}
{\small\textbf{\textcolor{accent}{Selected Projects:}}}
\vspace{0.5mm}

{% for project in exp.projects %}
{\small\textit{{ '{' }}{{ project.name }}{{ '}' }}}
\begin{itemize}[topsep=1pt,itemsep=1pt]
{% for bullet in project.bullets %}
\item {{ bullet }}
{% endfor %}
\end{itemize}
{% if not loop.last %}\vspace{1mm}{% endif %}
{% endfor %}
{% endif %}

{% if exp.technologies %}
\vspace{1mm}
{\small\textbf{Technologies:} {{ exp.technologies|join(', ') }}}
\vspace{1mm}
{% endif %}

\end{samepage}

{% if not loop.last %}
\divider
\vspace{-1mm}
{% endif %}

{% endfor %}

% EDUCATION
{% if education %}
% Ensure education section doesn't split
\needspace{4cm}
\cvsection{Education}
{% for edu in education %}
\cveventsmall{{ '{' }}{{ edu.degree }}{{ '}' }}{{ '{' }}{{ edu.institution }}{{ '}' }}{{ '{' }} 
  {%- if edu.start_year -%}{{ edu.start_year }}{%- endif -%}
  {%- if edu.end_year %} -- {{ edu.end_year }}{% endif -%}
{{ '}' }}{{ '{' }}{{ edu.location }}{{ '}' }}
{% if not loop.last %}
\vspace{-2mm}
\divider
{% else %}
\vspace{-2mm}
{% endif %}
{% endfor %}
{% endif %}

% CERTIFICATIONS
{% if certifications %}
\needspace{3cm}
\divider
\cveventsmall{Certifications:}{}{}{}
\vspace{-4mm}
{% for cert in certifications %}
\cvtag{{ '{' }}{{ cert }}{{ '}' }}
{% endfor %}
\vspace{1mm}
{% endif %}

% SKILLS
{% if skills %}
\needspace{5cm}
\cvsection{Skills}

{% for category, skill_list in skills.items() %}
{\small\textbf{{ '{' }}{{ category|replace('_', ' ')|title ~ ":" }}{{ '}' }}}
\vspace{0.5mm}
{% for skill in skill_list %}
\cvtag{{ '{' }}{{ skill }}{{ '}' }}
{% endfor %}
\vspace{1.5mm}

{% endfor %}
{% endif %}

% LANGUAGES
{% if languages %}
\needspace{2cm}
\cvsection{Languages}
{% for lang in languages %}
\cvtag{{ '{' }}{{ lang.name ~ ": " ~ lang.proficiency }}{{ '}' }}
{% endfor %}
\vspace{1mm}
{% endif %}

\end{document}
