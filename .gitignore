# Environment variables
.env
.env.local
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Real candidate data. Never public (ADR 0002, ADR 0011).
#
# These paths are untracked, not deleted: the files are still on disk and have
# been migrated to the private store at CVTAILOR_STORE (D:\coding\cv-tailor-data
# on this machine). This block is the guard -- without it a routine `git add -A`
# would sweep the owner's personal data straight back into the public repo.
#
# Synthetic fixtures under tests/fixtures/ are the only committed sample data.
# ---------------------------------------------------------------------------
/storage/profile/
/storage/profiles/
/applications/
/outputs/*

# Keep the placeholder so the directory still exists in a fresh clone.
!/outputs/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
env/
ENV/
.venv
*/.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Output files
outputs/**
!outputs/.gitkeep
.runtime/
outputs/*.pdf
outputs/*.docx
outputs/*.tex

# Source CV and cover letter examples (private)
cv_tex/
cover_letter_examples/
!outputs/.gitkeep

# Temporary files
*.log
*.aux
*.out
*.toc
*.synctex.gz
.tectonic-cache/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
# pytest temp-tree leftovers (sandbox artifacts; never source)
pytest-of-*/
pytest-cache-files-*/
.runtime-probe/

# Streamlit
.streamlit/secrets.toml

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Misc
*.bak
*.tmp
