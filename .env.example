# --- Providers -----------------------------------------------------------------------
#
# The DEFAULT provider is OpenRouter, because the model the curation study selected
# (`openai/gpt-6-luna`) is served there. Set OPENROUTER_API_KEY to run anything.
# Get a key from https://openrouter.ai/settings/keys -- it needs credit on the account.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gemini remains a supported provider and is used when CVTAILOR_PROVIDER=gemini.
# Not needed for the default path.
GEMINI_API_KEY=your_gemini_api_key_here

# Which provider to use. "openrouter" (default) or "gemini". An unknown name is
# refused rather than falling back.
# CVTAILOR_PROVIDER=openrouter

# The model to use. Provider-neutral, and it outranks a provider-specific variable.
# Defaults to openai/gpt-6-luna (ADR 0016).
# CVTAILOR_MODEL=openai/gpt-6-luna

# Optional ceiling on one generation run's estimated cost, in USD. A malformed value
# is an error, never a silently-ignored cap.
# CVTAILOR_MAX_COST_USD=1.00

# Gemini-only model override. Honoured ONLY when CVTAILOR_PROVIDER=gemini; it is
# deliberately ignored for other providers, so a leftover value here cannot redirect
# a run. Prefer CVTAILOR_MODEL above.
# GEMINI_MODEL=gemini-3.8-flash

# Temperature for LLM responses (0.0 = deterministic, 1.0 = creative)
GEMINI_TEMPERATURE=0.3

# Max tokens for output (adjust based on needs)
GEMINI_MAX_OUTPUT_TOKENS=8000

# --- Ports ---------------------------------------------------------------------------
# Read by scripts/start.py, which launches both services.
BACKEND_PORT=8000
UI_PORT=8501

# The Streamlit UI reaches the backend through BACKEND_URL. IMPORTANT: its built-in
# default is http://localhost:8000, so if you change BACKEND_PORT above you must set
# this to match or the UI will call the wrong port.
BACKEND_URL=http://localhost:8000

# --- Storage -------------------------------------------------------------------------
OUTPUTS_DIR=outputs

# Private profile store (ADR 0004, ADR 0011).
# Real profiles, applications and generated documents live OUTSIDE this public
# repository. The layout is <store>/profiles/<profile_id>/profile.yaml and
# <store>/outputs/<profile_id>/<job_id>/. Defaults to ./storage for a bare
# checkout, but point it at a private directory you own:
#   Windows: CVTAILOR_STORE=D:/coding/cv-tailor-data
#   macOS:   CVTAILOR_STORE=~/cv-tailor-data
CVTAILOR_STORE=storage

# Which candidate to act for. REQUIRED by every command that touches a
# candidate's data: there is no default profile and cv-tailor never infers one
# (ADR 0003). Run `cvtailor profile list` to see the ids you have.
# CVTAILOR_PROFILE_ID=sreedeep

# PROFILE_PATH is no longer read: a single process-wide profile path is exactly
# what multi-profile removed. Use --profile-id <id> for a store profile, or
# --profile <path> for a loose YAML file.

# Optional full path to pdflatex when it is not on PATH.
# LATEX_COMPILER=C:/Program Files/MiKTeX/miktex/bin/x64/pdflatex.exe
