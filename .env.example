# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Use a model available to your Gemini account. Existing project configuration:
GEMINI_MODEL=gemini-3.8-flash

# Temperature for LLM responses (0.0 = deterministic, 1.0 = creative)
GEMINI_TEMPERATURE=0.3

# Max tokens for output (adjust based on needs)
GEMINI_MAX_OUTPUT_TOKENS=8000

# Backend Configuration
BACKEND_HOST=localhost
BACKEND_PORT=8000

# UI Configuration
UI_HOST=localhost
UI_PORT=8501

# File Storage
OUTPUTS_DIR=outputs
TEMPLATES_DIR=templates

# Private profile store (ADR 0004, ADR 0011).
# Real profiles, applications and generated documents live OUTSIDE this public
# repository. The layout is <store>/profiles/<profile_id>/profile.yaml and
# <store>/outputs/<profile_id>/<job_id>/. Defaults to ./storage for a bare
# checkout, but point it at a private directory you own:
#   Windows: CVTAILOR_STORE=D:/coding/cv-tailor-data
#   macOS:   CVTAILOR_STORE=~/cv-tailor-data
CVTAILOR_STORE=storage

# Which candidate to act for. REQUIRED by every command that touches a
# candidate's data: there is no default profile and cv-tailor never infers one
# (ADR 0003). Run `cvtailor profile list` to see the ids you have.
# CVTAILOR_PROFILE_ID=sreedeep

# PROFILE_PATH is no longer read: a single process-wide profile path is exactly
# what multi-profile removed. Use --profile-id <id> for a store profile, or
# --profile <path> for a loose YAML file.

# Optional full path to pdflatex when it is not on PATH.
# LATEX_COMPILER=C:/Program Files/MiKTeX/miktex/bin/x64/pdflatex.exe
# BACKEND_URL=http://localhost:8000
